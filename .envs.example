# Gallery local environment file.
# Copy this file to `.envs` and fill in real values. `.envs` is ignored by git.

# Optional project settings.
# GALLERY_TITLE=末影画廊
# GALLERY_DESCRIPTION=
# GALLERY_SOURCE_DIR=photos
# GALLERY_OUTPUT_DIR=dist
# S3_PUBLIC_BASE_URL=https://media.example.com
# S3_ORIGINAL_PREFIX=originals

# Required for `npm run upload`.
# For Cloudflare R2, use the bucket's S3-compatible endpoint:
# https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
