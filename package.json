{
  "name": "gallery",
  "version": "1.0.0",
  "description": "TypeScript static gallery framework for camera photos, albums, EXIF metadata, thumbnails, and Cloudflare Pages deployment.",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "gallery": "./build/cli.js"
  },
  "files": [
    "build",
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:ts && npm run build:site",
    "build:site": "node build/cli.js build --outDir dist",
    "build:ts": "tsc -p tsconfig.build.json",
    "clean": "rimraf build dist coverage",
    "deadcode": "knip",
    "deploy": "npm run build && wrangler pages deploy dist --project-name gallery",
    "dev": "tsx src/cli.ts build --outDir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "wrangler pages dev dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wrangler:types": "wrangler types --path ./src/cloudflare-env.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moycat/gallery.git"
  },
  "keywords": [
    "cloudflare-pages",
    "exif",
    "gallery",
    "photography",
    "static-site",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/moycat/gallery/issues"
  },
  "homepage": "https://github.com/moycat/gallery#readme",
  "dependencies": {
    "exifr": "^7.1.3",
    "fast-glob": "^3.3.3",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.5.0",
    "knip": "^6.17.1",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
